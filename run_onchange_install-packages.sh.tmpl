#!/usr/bin/env bash
set -euo pipefail

LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$LOCAL_BIN"

# Detect OS
OS_ID=""
[[ -f /etc/os-release ]] && source /etc/os-release && OS_ID="${ID:-}"

# Brew wins on any OS if present — preferred CLI tool manager on all platforms.
if command -v brew &>/dev/null; then
  PKG_MANAGER="brew"
elif [[ "$OS_ID" == "bazzite" ]]; then
  PKG_MANAGER="bazzite"
elif command -v apt-get &>/dev/null; then
  PKG_MANAGER="apt"
elif command -v dnf &>/dev/null; then
  PKG_MANAGER="dnf"
else
  echo "No supported package manager found" >&2
  exit 1
fi

# Helper: install binary to ~/.local/bin if not already present
install_binary() {
  local name="$1" url="$2"
  command -v "$name" &>/dev/null && return
  curl -fsSL "$url" -o "$LOCAL_BIN/$name" && chmod +x "$LOCAL_BIN/$name"
}

case "$PKG_MANAGER" in
  brew)
    brew install fish starship micro croc fzf ripgrep eza btop tree jq gh wget neovim
    {{ if eq .chezmoi.os "darwin" -}}
    brew install docker docker-compose colima
    {{ else -}}
    brew install docker docker-compose
    {{ end -}}
    ;;

  bazzite)
    # Priority: binary installs to ~/.local/bin → rpm-ostree for system packages.
    # rpm-ostree changes require a reboot to take effect.

    # Binary installs (no system layering needed)
    command -v starship &>/dev/null || curl -sS https://starship.rs/install.sh | sh -s -- --bin-dir "$LOCAL_BIN" --yes
    command -v micro    &>/dev/null || { curl -fsSL https://getmic.ro | bash; mv micro "$LOCAL_BIN/"; }
    command -v croc     &>/dev/null || curl -fsSL https://getcroc.schollz.com | bash -s -- -b "$LOCAL_BIN"

    # GitHub CLI binary release
    if ! command -v gh &>/dev/null; then
      GH_VER=$(curl -fsSL https://api.github.com/repos/cli/cli/releases/latest | grep '"tag_name"' | cut -d'"' -f4 | tr -d 'v')
      curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VER}/gh_${GH_VER}_linux_amd64.tar.gz" \
        | tar -xz -C /tmp
      cp "/tmp/gh_${GH_VER}_linux_amd64/bin/gh" "$LOCAL_BIN/"
    fi

    # rpm-ostree for packages needing system integration.
    # Groups into one transaction to minimize reboots.
    # Docker is intentionally excluded — Podman ships pre-installed on Bazzite.
    # Need Docker? Run: ujust setup-virtualization
    OSTREE_PKGS=()
    for pkg in fish fzf ripgrep eza btop tree jq wget neovim; do
      command -v "$pkg" &>/dev/null || OSTREE_PKGS+=("$pkg")
    done

    if [[ ${#OSTREE_PKGS[@]} -gt 0 ]]; then
      echo "Installing via rpm-ostree (reboot required after): ${OSTREE_PKGS[*]}"
      sudo rpm-ostree install --idempotent "${OSTREE_PKGS[@]}"
    fi
    ;;

  apt)
    sudo apt-get update -qq

    # GitHub CLI repo
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt-get update -qq
    sudo apt-get install -y fish fzf ripgrep eza btop tree jq gh wget neovim

    command -v croc     &>/dev/null || curl -fsSL https://getcroc.schollz.com | bash
    command -v starship &>/dev/null || curl -sS https://starship.rs/install.sh | sh -s -- --yes
    command -v micro    &>/dev/null || { curl -fsSL https://getmic.ro | bash; sudo mv micro /usr/local/bin/; }

    # Docker
    if ! command -v docker &>/dev/null; then
      curl -fsSL https://get.docker.com | sh
      sudo apt-get install -y docker-compose-plugin
    fi
    ;;

  dnf)
    sudo dnf install -y fish fzf ripgrep eza btop tree jq wget neovim croc

    if ! command -v gh &>/dev/null; then
      sudo dnf install -y 'dnf-command(config-manager)'
      sudo dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo
      sudo dnf install -y gh
    fi

    command -v starship &>/dev/null || curl -sS https://starship.rs/install.sh | sh -s -- --yes
    command -v micro    &>/dev/null || { curl -fsSL https://getmic.ro | bash; sudo mv micro /usr/local/bin/; }

    if ! command -v docker &>/dev/null; then
      sudo dnf install -y dnf-plugins-core
      sudo dnf config-manager --add-repo https://download.docker.com/linux/fedora/docker-ce.repo
      sudo dnf install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
      sudo systemctl enable --now docker
    fi
    ;;
esac
