#!/bin/sh
set -eu

LOCAL_BIN="$HOME/.local/bin"
mkdir -p "$LOCAL_BIN"

# Detect OS
OS_ID=""
if [ -f /etc/os-release ]; then
  . /etc/os-release
  OS_ID="${ID:-}"
fi

# Brew wins on any OS if present — preferred CLI tool manager on all platforms.
if command -v brew >/dev/null 2>&1; then
  PKG_MANAGER="brew"
elif [ "$OS_ID" = "bazzite" ]; then
  PKG_MANAGER="bazzite"
elif command -v apt-get >/dev/null 2>&1; then
  PKG_MANAGER="apt"
elif command -v dnf >/dev/null 2>&1; then
  PKG_MANAGER="dnf"
else
  echo "No supported package manager found" >&2
  exit 1
fi

case "$PKG_MANAGER" in
  brew)
    brew install fish starship micro croc fzf ripgrep eza btop tree jq gh wget neovim ranger zellij
    {{ if eq .chezmoi.os "darwin" -}}
    brew install docker docker-compose colima
    {{ else -}}
    brew install docker docker-compose
    {{ end -}}
    ;;

  bazzite)
    # Binary installs to ~/.local/bin (no system layering needed)
    command -v starship >/dev/null 2>&1 || curl -sS https://starship.rs/install.sh | sh -s -- --bin-dir "$LOCAL_BIN" --yes
    command -v micro    >/dev/null 2>&1 || { curl -fsSL https://getmic.ro | sh; mv micro "$LOCAL_BIN/"; }
    command -v croc     >/dev/null 2>&1 || curl -fsSL https://getcroc.schollz.com | sh -s -- -b "$LOCAL_BIN"

    # GitHub CLI binary release
    if ! command -v gh >/dev/null 2>&1; then
      GH_VER=$(curl -fsSL https://api.github.com/repos/cli/cli/releases/latest | grep '"tag_name"' | cut -d'"' -f4 | tr -d 'v')
      curl -fsSL "https://github.com/cli/cli/releases/download/v${GH_VER}/gh_${GH_VER}_linux_amd64.tar.gz" \
        | tar -xz -C /tmp
      cp "/tmp/gh_${GH_VER}_linux_amd64/bin/gh" "$LOCAL_BIN/"
    fi

    # rpm-ostree for packages needing system integration (reboot required after).
    # Docker excluded — Podman ships pre-installed on Bazzite.
    # Need Docker? Run: ujust setup-virtualization
    OSTREE_PKGS=""
    for pkg in fish fzf ripgrep eza btop tree jq wget neovim ranger zellij; do
      command -v "$pkg" >/dev/null 2>&1 || OSTREE_PKGS="$OSTREE_PKGS $pkg"
    done
    if [ -n "$OSTREE_PKGS" ]; then
      echo "Installing via rpm-ostree (reboot required after):$OSTREE_PKGS"
      # shellcheck disable=SC2086
      sudo rpm-ostree install --idempotent $OSTREE_PKGS
    fi
    ;;

  apt)
    sudo apt-get update -qq

    # GitHub CLI repo
    curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    sudo apt-get update -qq
    sudo apt-get install -y fish fzf ripgrep btop tree jq gh wget neovim ranger

    # eza not in apt repos before Ubuntu 23.10 / Debian 13
    if ! sudo apt-get install -y eza 2>/dev/null; then
      EZA_VER=$(curl -fsSL https://api.github.com/repos/eza-community/eza/releases/latest | grep '"tag_name"' | cut -d'"' -f4)
      curl -fsSL "https://github.com/eza-community/eza/releases/download/${EZA_VER}/eza_x86_64-unknown-linux-gnu.tar.gz" \
        | tar -xz -C /tmp && sudo mv /tmp/eza /usr/local/bin/
    fi

    command -v croc     >/dev/null 2>&1 || curl -fsSL https://getcroc.schollz.com | sh
    command -v starship >/dev/null 2>&1 || curl -sS https://starship.rs/install.sh | sh -s -- --yes
    command -v micro    >/dev/null 2>&1 || { curl -fsSL https://getmic.ro | sh; sudo mv micro /usr/local/bin/; }

    # Docker
    if ! command -v docker >/dev/null 2>&1; then
      curl -fsSL https://get.docker.com | sh
      sudo apt-get install -y docker-compose-plugin
    fi
    ;;

  dnf)
    sudo dnf install -y fish fzf ripgrep eza btop tree jq wget neovim croc ranger zellij

    if ! command -v gh >/dev/null 2>&1; then
      sudo dnf install -y 'dnf-command(config-manager)'
      sudo dnf config-manager --add-repo https://cli.github.com/packages/rpm/gh-cli.repo
      sudo dnf install -y gh
    fi

    command -v starship >/dev/null 2>&1 || curl -sS https://starship.rs/install.sh | sh -s -- --yes
    command -v micro    >/dev/null 2>&1 || { curl -fsSL https://getmic.ro | sh; sudo mv micro /usr/local/bin/; }

    if ! command -v docker >/dev/null 2>&1; then
      sudo dnf install -y dnf-plugins-core
      sudo dnf config-manager --add-repo https://download.docker.com/linux/fedora/docker-ce.repo
      sudo dnf install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin
      sudo systemctl enable --now docker
    fi
    ;;
esac

# Claude Code CLI
command -v claude >/dev/null 2>&1 || curl -fsSL https://claude.ai/install.sh | sh
